# Dependencies
node_modules/
.pnp
.pnp.js

# Production build
dist/
build/

# Local environment and secret files
.env
.env.*
!.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.env.bak

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
Thumbs.db

# --- lanekeeper (managed) ---
# Runtime state, logs and agent worktrees are machine-local and must never be committed.
# Without these rules an agent running `git add -A` would sweep every other agent's
# worktree into its own commit.
/.lanekeeper/*
# The lane policy is the team's shared contract - keep it tracked.
!/.lanekeeper/config.yaml
# --- end lanekeeper ---
