# Gemini / LLM API Key (Optional for local mock mode, required for live AI clustering)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name (defaults to gemini-2.0-flash)
VITE_GEMINI_MODEL=gemini-2.0-flash

# Storage Mode: "local" (LocalStorage/IndexedDB) or "memory"
VITE_STORAGE_MODE=local
